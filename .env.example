# API base URL (required)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# CDN base URL for photo assets (required)
# Full URL = VITE_CDN_BASE_URL + "/" + storageKey
VITE_CDN_BASE_URL=https://cdn.titantv.com.ec

# Public origin of the app (required). Builds the absolute links that get
# copied or opened in a new tab: the public gallery and preview links.
# Production is https://titantv.com.ec; app.titantv.com.ec does not exist.
VITE_APP_BASE_URL=https://titantv.com.ec
