# API base URL (required)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# CDN base URL for photo assets (required)
# Full URL = VITE_CDN_BASE_URL + "/" + storageKey
VITE_CDN_BASE_URL=https://cdn.titantv.com.ec

# Public origin where operators paste delivery/preview links (required).
# Must match the customer-facing host so links sent from a dev session
# still point to the real production app.
VITE_APP_BASE_URL=https://app.titantv.com.ec
